# Go gateway + in-container Python KV-block hasher (single container).
#
# inline mode (default): the entrypoint launches the Python hasher on
#   127.0.0.1:9095 (shared router/prefix_hash.py) and then the gateway.
# external mode: the hasher is not started; the gateway calls the legacy
#   vllm-cpu-hash service over the network.
#
# Base mirrors the Python router image (python:3.11-slim) so the embedded
# hasher runs the exact same stack.
FROM python:3.11-slim

WORKDIR /app

# ---------- Proxy only for build (pip) ----------
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY} \
    no_proxy=${NO_PROXY}

# In-container hasher dependencies (used only in inline mode).
COPY go/hasher/requirements.txt /app/requirements.txt
COPY go/hasher/wheels /opt/hasher-wheels
ARG HASHER_OFFLINE_WHEELS=0
RUN if [ "$HASHER_OFFLINE_WHEELS" = "1" ]; then \
      pip install --no-cache-dir --no-index --find-links=/opt/hasher-wheels \
        -r /app/requirements.txt; \
    else \
      pip install --no-cache-dir -r /app/requirements.txt; \
    fi

# ---------- Clear proxy for runtime ----------
ENV http_proxy="" \
    https_proxy="" \
    HTTP_PROXY="" \
    HTTPS_PROXY="" \
    NO_PROXY="" \
    no_proxy=""

# Shared hashing package is copied directly from the canonical router source so
# engine-specific backends cannot drift from the Python router implementation.
COPY go/hasher/hasher_app.py /app/hasher_app.py
COPY router_service/router /app/router
COPY go/hasher/entrypoint.sh /usr/local/bin/router-entrypoint.sh
RUN chmod +x /usr/local/bin/router-entrypoint.sh

# Go gateway binary (compiled on the host by build.sh).
COPY go/gateway /usr/bin/gateway

# Offline HF + deterministic hash seed at runtime (tokenizer mounted at /model).
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONHASHSEED=0

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/router-entrypoint.sh"]

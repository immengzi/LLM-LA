# Go gateway + in-container Python KV-block hasher (single container).
#
# inline mode (default): the entrypoint launches the Python hasher on
#   127.0.0.1:9095 (shared router/prefix_hash.py) and then the gateway.
# external mode: the hasher is not started; the gateway calls the legacy
#   vllm-cpu-hash service over the network.
#
# Base mirrors the Python router image (python:3.11-slim) so the embedded
# hasher runs the exact same stack.
FROM python:3.11-slim

WORKDIR /app

# ---------- Proxy only for build (pip) ----------
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY} \
    no_proxy=${NO_PROXY}

# In-container hasher dependencies (used only in inline mode).
COPY hasher/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# ---------- Clear proxy for runtime ----------
ENV http_proxy="" \
    https_proxy="" \
    HTTP_PROXY="" \
    HTTPS_PROXY="" \
    NO_PROXY="" \
    no_proxy=""

# Shared hashing code. prefix_hash.py is staged into hasher/ by build.sh from
# src/core/services/router_service/router/prefix_hash.py (single source of truth).
COPY hasher/hasher_app.py /app/hasher_app.py
COPY hasher/prefix_hash.py /app/prefix_hash.py
COPY hasher/entrypoint.sh /usr/local/bin/router-entrypoint.sh
RUN chmod +x /usr/local/bin/router-entrypoint.sh

# Go gateway binary (compiled on the host by build.sh).
COPY gateway /usr/bin/gateway

# Offline HF + deterministic hash seed at runtime (tokenizer mounted at /model).
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONHASHSEED=0

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/router-entrypoint.sh"]

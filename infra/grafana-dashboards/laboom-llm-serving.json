        {
          "expr": "sum(rate(vllm:request_decode_time_seconds_sum{namespace=\"$namespace\"}[$__rate_interval])) / clamp_min(sum(rate(vllm:request_decode_time_seconds_count{namespace=\"$namespace\"}[$__rate_interval])), 1e-10)",
          "legendFormat": "decode time avg",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",

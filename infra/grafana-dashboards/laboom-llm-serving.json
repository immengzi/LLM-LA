    },
    {
      "id": 30,
      "title": "KV Cache Usage (per instance)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "vllm:kv_cache_usage_perc{namespace=\"$namespace\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20, "pointSize": 5, "showPoints": "auto", "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 31,
      "title": "Prefix Cache Hit Rate (per instance)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(vllm:prefix_cache_hits_total{namespace=\"$namespace\"}[$__rate_interval]) / clamp_min(rate(vllm:prefix_cache_queries_total{namespace=\"$namespace\"}[$__rate_interval]), 1e-10)",
          "legendFormat": "local {{instance}}",
          "refId": "A"
        },
        {
          "expr": "rate(vllm:external_prefix_cache_hits_total{namespace=\"$namespace\"}[$__rate_interval]) / clamp_min(rate(vllm:external_prefix_cache_queries_total{namespace=\"$namespace\"}[$__rate_interval]), 1e-10)",
          "legendFormat": "external {{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "pointSize": 5, "showPoints": "auto" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 32,
      "title": "Cached Prompt Tokens / Prefill Breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(vllm:prompt_tokens_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "total prefill tok/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(vllm:prompt_tokens_cached_total{namespace=\"$namespace\"}[$__rate_interval]))",

    },
    {
      "id": 40,
      "title": "Queue Time / Prefill Time / Decode Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(vllm:request_queue_time_seconds_sum{namespace=\"$namespace\"}[$__rate_interval])) / clamp_min(sum(rate(vllm:request_queue_time_seconds_count{namespace=\"$namespace\"}[$__rate_interval])), 1e-10)",
          "legendFormat": "queue time avg",
          "refId": "A"

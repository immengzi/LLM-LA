      "title": "Prompt / Generation Token Sizes (avg)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(vllm:request_prompt_tokens_sum{namespace=\"$namespace\"}[$__rate_interval])) / clamp_min(sum(rate(vllm:request_prompt_tokens_count{namespace=\"$namespace\"}[$__rate_interval])), 1e-10)",
          "legendFormat": "avg prompt tokens",
          "refId": "A"
        },
        {
          "expr": "sum(rate(vllm:request_generation_tokens_sum{namespace=\"$namespace\"}[$__rate_interval])) / clamp_min(sum(rate(vllm:request_generation_tokens_count{namespace=\"$namespace\"}[$__rate_interval])), 1e-10)",
          "legendFormat": "avg generation tokens",
          "refId": "B"
        }
